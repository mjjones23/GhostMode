# Copy this file to backend/.env
# NEVER commit backend/.env or put OPENAI_API_KEY in the mobile app.

# Port for the Ghost Mode backend API (local and hosted)
PORT=3001

# OpenAI — get a key at https://platform.openai.com/api-keys
# This key stays on the server only.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Free / Pro AI quota. Client must send enforceQuota:true to apply.
# QUOTA_ENFORCEMENT=true
# AI_FREE_MESSAGE_LIMIT=10
# AI_PRO_MESSAGE_LIMIT=200
# AI_FREE_WINDOW_MS=18000000
# GHOST_PRO_ACCOUNT_IDS=
# PRO_BYPASS_SECRET=
# QUOTA_DATA_DIR=
# ENTITLEMENT_DATA_DIR=

# Voice STT/TTS (server-side only — do not put these in the mobile app)
# VOICE_STT_API_KEY=
# VOICE_TTS_API_KEY=
# VOICE_MAX_SECONDS=45

# Account sync (keep false until Firebase/migration review)
# CLOUD_SYNC_ENABLED=false
# ACCOUNT_SYNC_DATA_DIR=

# RevenueCat webhook (optional; does not enable live IAP by itself)
# REVENUECAT_WEBHOOK_SECRET=

# For TestFlight/App Store: deploy this backend behind public HTTPS
# (Railway, Render, Fly.io, etc.), set OPENAI_API_KEY on the host,
# then put that HTTPS origin in eas.json as EXPO_PUBLIC_COACH_API_URL.
# Do not deploy Batch 2 routes to production without review.