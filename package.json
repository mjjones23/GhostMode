{
  "name": "ghostmode",
  "version": "1.2.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "npm start --prefix server",
    "server:install": "npm install --prefix server",
    "backend": "npm start --prefix backend",
    "backend:install": "npm install --prefix backend",
    "check:imports": "node scripts/check-imports.js",
    "test:coach-context": "node backend/test-coach-context.js && node scripts/test-coach-context-app.js",
    "test:coach-memory": "node backend/test-coach-memory.js && node scripts/test-coach-memory-app.js",
    "build:ios": "eas build --platform ios --profile production --auto-submit",
    "build:ios:only": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-notifications": "~58.1.8",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "private": true
}
