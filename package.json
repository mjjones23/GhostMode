{
  "name": "ghostmode",
  "version": "1.2.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "npm start --prefix server",
    "server:install": "npm install --prefix server",
    "backend": "npm start --prefix backend",
    "backend:install": "npm install --prefix backend",
    "check:imports": "node scripts/check-imports.js",
    "build:ios": "eas build --platform ios --profile production --auto-submit",
    "build:ios:only": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0"
  },
  "private": true
}
